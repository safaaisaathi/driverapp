# Template for the PRIVATE build-defines file (PRD-2 §0.10: ".env and
# google-services.json are shared privately" — this file is gitignored).
#
# Copy to `.env`, then fill the three values from the flutterfire
# configure output (or the Firebase console). Plain key=value, no quotes,
# `#` comments. Consumed at compile time — the Dart code reads them via
# String.fromEnvironment, so changing the delivery method needs no code
# changes.
#
# Two ways to run with it:
#   flutter run --dart-define-from-file=.env -d <deviceId>
#   ./scripts/run_device.sh <deviceId>        (wraps the line above)
#
# Emulator-mode runs are separate (the key must not be defined in both a
# defines-file and --dart-define):
#   flutter run --dart-define=DRIVERAPP_USE_EMULATOR=true \
#     --dart-define=DRIVERAPP_EMULATOR_HOST=<dev-machine LAN IP> -d <deviceId>
DRIVERAPP_USE_EMULATOR=false
DRIVERAPP_FB_API_KEY=
DRIVERAPP_FB_APP_ID=
DRIVERAPP_FB_SENDER_ID=
